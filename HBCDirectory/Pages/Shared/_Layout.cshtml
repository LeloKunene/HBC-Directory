<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]Heritage Directory</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/directory.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HBCDirectory.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;800&family=Open+Sans:wght@300;400;600;700&display=swap"
    rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#202222" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="HBC Directory" />
</head>

<body>
    <div class="app-toast-stack" id="app-toast-stack" aria-live="polite" aria-atomic="true"></div>

    @if (ViewData["HideNav"] as bool? != true)
    {
        <header>

            <nav class="nav navbar navbar-expand-sm sticky-top">
                <div class="container">
                    <a class="navbar-brand" asp-area="" asp-page="/Index">
                        <img src="https://www.heritagebaptistlibrary.co.za/file.png" alt="Heritage Logo" class="nav-logo"
                             loading="lazy" />
                        <span>Heritage Directory</span>
                    </a>
                    <button class="hamburger navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="hamburger-bar"></span>
                        <span class="hamburger-bar"></span>
                        <span class="hamburger-bar"></span>
                    </button>
                    <div class="collapse navbar-collapse nav-links" id="navbarNav">
                        <ul class="navbar-nav flex-grow-1">
                            <li>
                                <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                            </li>
                            

                            @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Leadership")))
                            {
                                <li>
                                    <a asp-page="/Admin" class="nav-link">Admin</a>
                                </li>
                            }
                            @if (User.IsInRole("Leadership"))
                            {
                                <li>
                                    <a asp-page="/MemberManagement/Index" class="nav-link">Member Management</a>
                                </li>
                            }
                            @if (User.IsInRole("Member"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-page="/Profile/Index">My Profile</a>
                                </li>
                            }

                            <li class="d-flex align-items-center">
                                <button type="button" class="nav-report-issue-btn" data-bs-toggle="modal" data-bs-target="#reportIssueModal"
                                        title="Report an issue" aria-label="Report an issue">
                                    <i class="fa-solid fa-question"></i>
                                </button>
                            </li>
                            <li>
                                <a asp-page="/Logout" class="btn btn-logout">Logout</a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>
        }
        @if (ViewData["HideChrome"] as bool? == true)
        {
            @RenderBody()
        }

        <div class="container">
            <main role="main" class="pb-3 main-content">
                @RenderBody()
            </main>
        </div>

    
        @if (ViewData["HideFooter"] as bool? != true)
        {
            <footer class="border-top footer text-muted">
                <div class="container">
                    &copy; 2026 - Heritage Baptist Church Directory
                </div>
            </footer>
        }

   
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @{
            /* Every page's "flash" success/error message flows through here.
                set TempData["Success"]/TempData["Error"] in any handler before
                a RedirectToPage() and it shows as a toast on the next page,
                with no per-page markup needed. Read once, here, so it's
                consumed exactly once per request regardless of which page set it.*/
            var toastSuccess = TempData["Success"] as string;
            var toastError   = TempData["Error"]   as string;
        }
        @if (!string.IsNullOrEmpty(toastSuccess))
        {
            <script>document.addEventListener('DOMContentLoaded', () => window.showToast(@Json.Serialize(toastSuccess), 'success'));</script>
        }
        @if (!string.IsNullOrEmpty(toastError))
        {
            <script>document.addEventListener('DOMContentLoaded', () => window.showToast(@Json.Serialize(toastError), 'error'));</script>
        }
        <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
            navigator.serviceWorker.register('/service-worker.js')
                .then(reg => console.log('SW registered'))
                .catch(err => console.log('SW error:', err));
            });
        }
        </script>

        <!-- Report an Issue — reachable from every page via the nav icon.
             Posts to the standalone /ReportIssue page rather than a
             per-page handler, since this modal lives here in the shared
             layout, not on any one page. -->
        <div class="modal fade" id="reportIssueModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Report an issue</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="post" asp-page="/ReportIssue" id="reportIssueForm">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">What kind of issue?</label>
                                <div class="report-issue-category-group" id="reportIssueCategoryGroup">
                                    <input type="hidden" name="category" id="reportIssueCategory" value="Bug" />
                                    <button type="button" class="report-issue-category-btn active" data-value="Bug">Bug</button>
                                    <button type="button" class="report-issue-category-btn" data-value="Suggestion">Suggestion</button>
                                    <button type="button" class="report-issue-category-btn" data-value="Other">Other</button>
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">What happened?</label>
                                <textarea name="description" class="form-control" rows="4" required
                                          placeholder="Describe what you were doing and what went wrong..."></textarea>
                            </div>
                            <p class="small text-muted mb-0">
                                <i class="fa-solid fa-circle-info me-1"></i>
                                We'll automatically include the page you're on and your account, so you don't have to explain where you were.
                            </p>
                            <input type="hidden" name="pageUrl" id="reportIssuePageUrl" />
                            <input type="hidden" name="userAgent" id="reportIssueUserAgent" />
                            <input type="hidden" name="returnUrl" id="reportIssueReturnUrl" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">
                                <i class="fa-solid fa-paper-plane me-2"></i>Send Report
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <script>
        (function () {
            var form = document.getElementById('reportIssueForm');
            if (!form) return;
            form.addEventListener('submit', function () {
                document.getElementById('reportIssuePageUrl').value   = window.location.href;
                document.getElementById('reportIssueUserAgent').value = navigator.userAgent;
                document.getElementById('reportIssueReturnUrl').value = window.location.pathname + window.location.search;
            });
            document.querySelectorAll('.report-issue-category-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.report-issue-category-btn').forEach(function (b) { b.classList.remove('active'); });
                    btn.classList.add('active');
                    document.getElementById('reportIssueCategory').value = btn.dataset.value;
                });
            });
        })();
        </script>

        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>